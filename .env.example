# Copy to .env and fill in. Prisma reads .env; Next.js reads .env and .env.local.

# Prisma database (SQLite file by default; use a postgresql:// URL after switching the provider)
DATABASE_URL="file:./prisma/dev.db"

# Stripe — test keys from https://dashboard.stripe.com/test/apikeys (both must be from the same account)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Firebase Authentication (optional: defaults to the original crwn-db project)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
